# API
PORT=3000
DATABASE_URL=postgresql://social:social@localhost:5433/social
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=social-media
S3_REGION=us-east-1
# URL phones use for uploads/downloads (your PC's LAN IP), if different from S3_ENDPOINT
# S3_PUBLIC_ENDPOINT=http://192.168.1.10:9090

# LiveKit (live streaming). LIVEKIT_URL is what phones connect to: use your PC's LAN IP on a real device.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-devsecret
